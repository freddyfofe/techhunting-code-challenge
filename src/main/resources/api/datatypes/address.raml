#%RAML 1.0 DataType

type: object

properties:
  street:
    type: string
    required: false
    example: 123 Main St

  streetLine:
    type: string
    required: false
    example: 456 Oak Ave

  city:
    type: string
    required: false
    example: Anytown

  state:
    type: string
    required: false
    example: CA

  region:
    type: string
    required: false
    example: NY

  postalCode:
    type: string
    required: false
    example: "90210"

  zip:
    type: string
    required: false
    example: "10001"

  country:
    type: string
    required: false
    example: US